# Copy to .env for local runs (never commit .env).
# Render injects PORT automatically; the server binds HOST:PORT.
PORT=8080
HOST=0.0.0.0
# HMAC secret for guest tokens. If unset, a random one is generated per process
# (guests then get new ids after every restart).
SESSION_SECRET=change-me-to-a-long-random-string
# Directory with the built web client (apps/web/dist). Empty = API/WebSocket only.
STATIC_DIR=apps/web/dist
# Seconds a disconnected player keeps their seat before forfeiting.
RECONNECT_GRACE_SECONDS=20
# Seconds a new match waits for both clients to finish loading.
READY_TIMEOUT_SECONDS=25
# Upper bound on concurrent matches (protects small instances).
MAX_MATCHES=200
# Threads that tick matches (default: min(4, cores)).
TICK_THREADS=2
# Optional directory for replay JSON files (Render disks are ephemeral unless you attach one).
REPLAY_DIR=
# Extra JVM flags.
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseSerialGC
